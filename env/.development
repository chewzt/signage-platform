# EFS_VOLUME_NAME=
# EFS_ID=
# EFS_ROOT_DIR=
# EFS_CONTAINER_PATH=
REPLICAS=1

APP_NAME=Signage
APP_ENV=development
APP_KEY=base64:jPlMpietzdSUy3QTfeQIBEAzLKbiPWM5Qv3/YL5EvzU=
APP_DEBUG=true
APP_URL=https://display-management-system.nextale-sit.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=rds.nextale-sit.local
DB_PORT=3306
DB_DATABASE=display_management
DB_USERNAME=serviceaccount
DB_PASSWORD=9z68K33WaY4LWK0c

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the queue worker's --timeout=3600 so long transcodes aren't retried mid-run.
DB_QUEUE_RETRY_AFTER=3660

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

