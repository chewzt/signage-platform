
#ECS Specific
SOFT_CPU=0
CONTAINER_MEMORY_RESERVATION=400
CONTAINER_MEMORY_LIMIT=4096
PORT=80
EXTERNAL=yes
# TODO: confirm the SIT hostname for this app.
HOST_NAME_EXTERNAL=display-management-system.nextale-sit.com
# Media lives in S3 (MEDIA_DISK=s3), so no EFS volume is needed.
