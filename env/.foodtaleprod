
#ECS Specific
SOFT_CPU=64
CONTAINER_MEMORY_RESERVATION=400
CONTAINER_MEMORY_LIMIT=4096
PORT=80
EXTERNAL=yes
# TODO: production hostname for this app.
HOST_NAME_EXTERNAL=__PROD_HOSTNAME__
# Media lives in S3 (MEDIA_DISK=s3), so no EFS volume is needed.
# Uncomment only if the shared deploy workflow requires these keys.
# EFS_VOLUME_NAME=
# EFS_ID=
# EFS_ROOT_DIR=
# EFS_CONTAINER_PATH=
REPLICAS=2

APP_NAME=Signage
APP_ENV=production
# TODO: set with `php artisan key:generate --show` (ideally as an ECS secret, not in git).
# The container refuses to start while this is blank. Never change it once set.
APP_KEY=
APP_DEBUG=false
APP_URL=https://__PROD_HOSTNAME__

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# TODO: production database (or inject DB_* as ECS secrets).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=display_management
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the queue worker's --timeout=3600 so long transcodes aren't retried mid-run.
DB_QUEUE_RETRY_AFTER=3660

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# TODO: production media bucket (or use an ECS task role and leave the keys blank).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MEDIA_DISK=s3

# TODO: set a random secret (e.g. `openssl rand -base64 48`), ideally as an ECS secret.
JWT_SECRET=

VITE_APP_NAME="${APP_NAME}"
